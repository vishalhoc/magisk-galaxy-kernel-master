#!/system/bin/sh
# Galaxy Kernel Master & Router Control Engine v2.0
# Created by hoc for Samsung Galaxy M32 5G (MT6853 / Dimensity 720)

STATE_DIR="/data/adb/kernel_master_state"
mkdir -p "$STATE_DIR"

# Ensure common sysfs/proc files are accessible by root
ensure_permissions() {
    chmod 666 /sys/block/sd*/queue/scheduler 2>/dev/null
    chmod 666 /sys/block/sd*/queue/read_ahead_kb 2>/dev/null
    chmod 666 /proc/ppm/policy_status 2>/dev/null
    chmod 666 /proc/ppm/policy/* 2>/dev/null
    chmod 666 /sys/devices/system/cpu/cpufreq/policy*/scaling_governor 2>/dev/null
    chmod 666 /sys/devices/system/cpu/cpufreq/policy*/scaling_min_freq 2>/dev/null
    chmod 666 /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq 2>/dev/null
    chmod 666 /sys/class/power_supply/battery/store_mode 2>/dev/null
    chmod 666 /sys/class/power_supply/battery/batt_slate_mode 2>/dev/null
}
ensure_permissions

save_factory_defaults() {
    if [ ! -f "$STATE_DIR/factory_defaults_saved" ]; then
        cat /proc/sys/net/ipv4/ip_forward > "$STATE_DIR/orig_ip_forward" 2>/dev/null
        cat /proc/sys/net/ipv6/conf/all/forwarding > "$STATE_DIR/orig_ipv6_forward" 2>/dev/null
        cat /proc/sys/net/ipv4/tcp_congestion_control > "$STATE_DIR/orig_tcp_cong" 2>/dev/null
        cat /proc/sys/net/ipv4/tcp_fastopen > "$STATE_DIR/orig_tcp_fastopen" 2>/dev/null
        cat /proc/sys/net/ipv4/tcp_ecn > "$STATE_DIR/orig_tcp_ecn" 2>/dev/null
        cat /proc/sys/vm/swappiness > "$STATE_DIR/orig_swappiness" 2>/dev/null
        cat /proc/sys/vm/dirty_ratio > "$STATE_DIR/orig_dirty_ratio" 2>/dev/null
        cat /proc/sys/vm/dirty_background_ratio > "$STATE_DIR/orig_dirty_bg_ratio" 2>/dev/null
        cat /proc/sys/vm/vfs_cache_pressure > "$STATE_DIR/orig_vfs_cache_pressure" 2>/dev/null
        cat /proc/sys/kernel/sched_child_runs_first > "$STATE_DIR/orig_sched_child_runs_first" 2>/dev/null
        cat /proc/sys/kernel/sched_latency_ns > "$STATE_DIR/orig_sched_latency_ns" 2>/dev/null
        cat /proc/sys/kernel/sched_min_granularity_ns > "$STATE_DIR/orig_sched_min_granularity_ns" 2>/dev/null
        cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor > "$STATE_DIR/orig_cpu_gov0" 2>/dev/null
        cat /sys/devices/system/cpu/cpufreq/policy6/scaling_governor > "$STATE_DIR/orig_cpu_gov6" 2>/dev/null
        cat /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq > "$STATE_DIR/orig_cpu_max_freq6" 2>/dev/null
        cat /proc/sys/net/core/rmem_max > "$STATE_DIR/orig_rmem_max" 2>/dev/null
        cat /proc/sys/net/core/wmem_max > "$STATE_DIR/orig_wmem_max" 2>/dev/null
        cat /sys/block/sdc/queue/scheduler > "$STATE_DIR/orig_io_scheduler" 2>/dev/null
        settings get global tether_dun_required > "$STATE_DIR/orig_dun_required" 2>/dev/null
        touch "$STATE_DIR/factory_defaults_saved"
    fi
}
save_factory_defaults

action="$1"
shift

case "$action" in
    status)
        # 1. CPU Telemetry
        gov0=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null || echo unknown)
        cur0=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_cur_freq 2>/dev/null || echo 0)
        min0=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 2>/dev/null || echo 500000)
        max0=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 2>/dev/null || echo 2000000)
        avail_govs=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_available_governors 2>/dev/null || echo "schedutil performance powersave ondemand")
        avail_freqs0=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_available_frequencies 2>/dev/null)

        gov6=$(cat /sys/devices/system/cpu/cpufreq/policy6/scaling_governor 2>/dev/null || echo unknown)
        cur6=$(cat /sys/devices/system/cpu/cpufreq/policy6/scaling_cur_freq 2>/dev/null || echo 0)
        min6=$(cat /sys/devices/system/cpu/cpufreq/policy6/scaling_min_freq 2>/dev/null || echo 725000)
        max6=$(cat /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq 2>/dev/null || echo 1650000)
        avail_freqs6=$(cat /sys/devices/system/cpu/cpufreq/policy6/scaling_available_frequencies 2>/dev/null)
        [ "$max6" -ge 2000000 ] && unlocked_2ghz=1 || unlocked_2ghz=0

        # 2. MediaTek PPM Telemetry
        ppm_en=$(cat /proc/ppm/enabled 2>/dev/null | grep -q "enabled" && echo 1 || echo 0)
        ppm_boost=$(cat /proc/ppm/policy_status 2>/dev/null | grep "SYS_BOOST" | grep -q "enabled" && echo 1 || echo 0)
        ppm_thermal_active=$(cat /proc/ppm/policy_status 2>/dev/null | grep "THERMAL" | grep -q "enabled" && echo 1 || echo 0)

        # 3. Memory & ZRAM
        swappiness=$(cat /proc/sys/vm/swappiness 2>/dev/null || echo 160)
        dirty_ratio=$(cat /proc/sys/vm/dirty_ratio 2>/dev/null || echo 0)
        dirty_bg_ratio=$(cat /proc/sys/vm/dirty_background_ratio 2>/dev/null || echo 0)
        vfs_pressure=$(cat /proc/sys/vm/vfs_cache_pressure 2>/dev/null || echo 100)
        dirty_expire=$(cat /proc/sys/vm/dirty_expire_centisecs 2>/dev/null || echo 200)
        dirty_writeback=$(cat /proc/sys/vm/dirty_writeback_centisecs 2>/dev/null || echo 500)
        zram_algo=$(cat /sys/block/zram0/comp_algorithm 2>/dev/null || echo unknown)
        zram_size=$(cat /sys/block/zram0/disksize 2>/dev/null || echo 0)
        zram_used=$(cat /proc/swaps 2>/dev/null | grep zram0 | awk '{print $4}' || echo 0)

        # 4. Storage & UFS
        io_sched=$(cat /sys/block/sda/queue/scheduler 2>/dev/null || cat /sys/block/sdc/queue/scheduler 2>/dev/null || echo unknown)
        read_ahead=$(cat "$STATE_DIR/cur_read_ahead" 2>/dev/null || echo 128)

        # 5. Kernel Process Scheduler (EAS)
        sched_child_first=$(cat /proc/sys/kernel/sched_child_runs_first 2>/dev/null || echo 0)
        sched_latency=$(cat /proc/sys/kernel/sched_latency_ns 2>/dev/null || echo 10000000)
        sched_min_gran=$(cat /proc/sys/kernel/sched_min_granularity_ns 2>/dev/null || echo 3000000)
        sched_wakeup_gran=$(cat /proc/sys/kernel/sched_wakeup_granularity_ns 2>/dev/null || echo 2000000)

        # 6. Network & TCP
        tcp_cong=$(cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null || echo unknown)
        tcp_avail=$(cat /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null || echo "bic reno cubic")
        tcp_fastopen=$(cat /proc/sys/net/ipv4/tcp_fastopen 2>/dev/null || echo 1)
        tcp_ecn=$(cat /proc/sys/net/ipv4/tcp_ecn 2>/dev/null || echo 2)
        tcp_sack=$(cat /proc/sys/net/ipv4/tcp_sack 2>/dev/null || echo 1)
        tcp_wscale=$(cat /proc/sys/net/ipv4/tcp_window_scaling 2>/dev/null || echo 1)
        tcp_tw_reuse=$(cat /proc/sys/net/ipv4/tcp_tw_reuse 2>/dev/null || echo 0)
        tcp_slow_start_idle=$(cat /proc/sys/net/ipv4/tcp_slow_start_after_idle 2>/dev/null || echo 1)
        rmem_max=$(cat /proc/sys/net/core/rmem_max 2>/dev/null || echo 0)
        wmem_max=$(cat /proc/sys/net/core/wmem_max 2>/dev/null || echo 0)
        ip_fwd=$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null || echo 0)
        ipv6_fwd=$(cat /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null || echo 0)

        # Router Rules & RPS
        iptables -t nat -C POSTROUTING -o rmnet+ -j MASQUERADE 2>/dev/null && nat_active=1 || nat_active=0
        [ "$(settings get global tether_dun_required 2>/dev/null)" = "0" ] && dun_active=1 || dun_active=0
        [ "$(cat /sys/class/net/wlan0/queues/rx-0/rps_cpus 2>/dev/null)" = "ff" ] && rps_active=1 || rps_active=0
        [ "$(getprop service.adb.tcp.port 2>/dev/null)" = "5555" ] && adb_active=1 || adb_active=0

        # 7. Battery & Thermal Hardware
        batt_status=$(cat /sys/class/power_supply/battery/status 2>/dev/null || echo Discharging)
        batt_cap=$(cat /sys/class/power_supply/battery/capacity 2>/dev/null || echo 0)
        batt_health=$(cat /sys/class/power_supply/battery/fg_asoc 2>/dev/null || echo 100)
        batt_cycles=$(cat /sys/class/power_supply/battery/fg_cycle 2>/dev/null || echo 0)
        batt_current=$(cat /sys/class/power_supply/battery/current_now 2>/dev/null || echo 0)
        batt_voltage=$(cat /sys/class/power_supply/battery/voltage_now 2>/dev/null || echo 0)
        batt_temp_raw=$(cat /sys/class/power_supply/battery/temp 2>/dev/null || echo 250)
        batt_temp=$((batt_temp_raw / 10))
        store_mode=$(cat /sys/class/power_supply/battery/store_mode 2>/dev/null || echo 0)

        soc_temp_raw=$(cat /sys/class/thermal/thermal_zone1/temp 2>/dev/null || echo 0)
        soc_temp=$((soc_temp_raw / 1000))
        modem_temp_raw=$(cat /sys/class/thermal/thermal_zone12/temp 2>/dev/null || echo 0)
        modem_temp=$((modem_temp_raw / 1000))
        wifi_temp_raw=$(cat /sys/class/thermal/thermal_zone36/temp 2>/dev/null || echo 0)
        wifi_temp=$((wifi_temp_raw / 1000))

        # 8. System & Radio
        kernel_ver=$(uname -r 2>/dev/null)
        net_type=$(getprop gsm.network.type 2>/dev/null || echo Unknown)
        sim_op=$(getprop gsm.sim.operator.alpha 2>/dev/null || echo Unknown)
        ifaces=$(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | tr '\n' ' ')

        echo "{"
        echo "  \"kernel\": \"$kernel_ver\","
        echo "  \"cpu_gov_little\": \"$gov0\","
        echo "  \"cpu_freq_little\": $cur0,"
        echo "  \"cpu_min_freq_little\": $min0,"
        echo "  \"cpu_max_freq_little\": $max0,"
        echo "  \"cpu_avail_freqs_little\": \"$avail_freqs0\","
        echo "  \"cpu_gov_big\": \"$gov6\","
        echo "  \"cpu_freq_big\": $cur6,"
        echo "  \"cpu_min_freq_big\": $min6,"
        echo "  \"cpu_max_freq_big\": $max6,"
        echo "  \"cpu_avail_freqs_big\": \"$avail_freqs6\","
        echo "  \"cpu_avail_govs\": \"$avail_govs\","
        echo "  \"unlocked_2ghz\": $unlocked_2ghz,"
        echo "  \"ppm_enabled\": $ppm_en,"
        echo "  \"ppm_boost\": $ppm_boost,"
        echo "  \"ppm_thermal_active\": $ppm_thermal_active,"
        echo "  \"swappiness\": $swappiness,"
        echo "  \"dirty_ratio\": $dirty_ratio,"
        echo "  \"dirty_bg_ratio\": $dirty_bg_ratio,"
        echo "  \"vfs_pressure\": $vfs_pressure,"
        echo "  \"dirty_expire\": $dirty_expire,"
        echo "  \"dirty_writeback\": $dirty_writeback,"
        echo "  \"zram_algo\": \"$zram_algo\","
        echo "  \"zram_size\": $zram_size,"
        echo "  \"zram_used\": \"$zram_used\","
        echo "  \"io_sched\": \"$io_sched\","
        echo "  \"read_ahead_kb\": $read_ahead,"
        echo "  \"sched_child_first\": $sched_child_first,"
        echo "  \"sched_latency_ns\": $sched_latency,"
        echo "  \"sched_min_gran_ns\": $sched_min_gran,"
        echo "  \"sched_wakeup_gran_ns\": $sched_wakeup_gran,"
        echo "  \"tcp_congestion\": \"$tcp_cong\","
        echo "  \"tcp_available\": \"$tcp_avail\","
        echo "  \"tcp_fastopen\": $tcp_fastopen,"
        echo "  \"tcp_ecn\": $tcp_ecn,"
        echo "  \"tcp_sack\": $tcp_sack,"
        echo "  \"tcp_wscale\": $tcp_wscale,"
        echo "  \"tcp_tw_reuse\": $tcp_tw_reuse,"
        echo "  \"tcp_slow_start_idle\": $tcp_slow_start_idle,"
        echo "  \"rmem_max\": $rmem_max,"
        echo "  \"wmem_max\": $wmem_max,"
        echo "  \"ip_forward\": $ip_fwd,"
        echo "  \"ipv6_forward\": $ipv6_fwd,"
        echo "  \"nat_active\": $nat_active,"
        echo "  \"dun_bypass\": $dun_active,"
        echo "  \"rps_active\": $rps_active,"
        echo "  \"adb_wifi\": $adb_active,"
        echo "  \"batt_status\": \"$batt_status\","
        echo "  \"batt_capacity\": $batt_cap,"
        echo "  \"batt_health_asoc\": $batt_health,"
        echo "  \"batt_cycles\": $batt_cycles,"
        echo "  \"batt_current_ma\": $batt_current,"
        echo "  \"batt_voltage_mv\": $((batt_voltage / 1000)),"
        echo "  \"batt_temp\": $batt_temp,"
        echo "  \"soc_temp\": $soc_temp,"
        echo "  \"modem_temp\": $modem_temp,"
        echo "  \"wifi_temp\": $wifi_temp,"
        echo "  \"store_mode\": $store_mode,"
        echo "  \"network_type\": \"$net_type\","
        echo "  \"carrier\": \"$sim_op\","
        echo "  \"interfaces\": \"$ifaces\""
        echo "}"
        ;;

    set_cpu_gov)
        gov="$1"
        cluster="${2:-all}"
        if [ -n "$gov" ]; then
            if [ "$cluster" = "0" ] || [ "$cluster" = "all" ]; then
                echo "$gov" > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null
            fi
            if [ "$cluster" = "6" ] || [ "$cluster" = "all" ]; then
                echo "$gov" > /sys/devices/system/cpu/cpufreq/policy6/scaling_governor 2>/dev/null
            fi
            echo "{\"status\": \"ok\", \"message\": \"CPU governor set to $gov on cluster $cluster\"}"
        fi
        ;;

    set_cpu_unlock_2ghz)
        val="$1"
        if [ "$val" = "1" ]; then
            chmod 666 /proc/ppm/policy/* 2>/dev/null
            echo "1 -1" > /proc/ppm/policy/userlimit_max_cpu_freq 2>/dev/null
            echo 2000000 > /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq 2>/dev/null
            echo '{"status": "ok", "message": "Big cores (A76) unlocked to 2.0 GHz maximum frequency"}'
        else
            echo "1 6" > /proc/ppm/policy/userlimit_max_cpu_freq 2>/dev/null
            echo 1650000 > /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq 2>/dev/null
            echo '{"status": "ok", "message": "Big cores (A76) reverted to stock 1.65 GHz thermal cap"}'
        fi
        ;;

    set_cpu_freq)
        cluster="$1"
        which_limit="$2" # min or max
        freq="$3"
        if [ -n "$freq" ] && [ -n "$cluster" ]; then
            node="/sys/devices/system/cpu/cpufreq/policy$cluster/scaling_${which_limit}_freq"
            chmod 666 "$node" 2>/dev/null
            echo "$freq" > "$node" 2>/dev/null
            echo "{\"status\": \"ok\", \"message\": \"Cluster $cluster $which_limit freq set to $freq kHz\"}"
        fi
        ;;

    set_ppm_enabled)
        val="$1"
        echo "$val" > /proc/ppm/enabled 2>/dev/null
        echo "{\"status\": \"ok\", \"message\": \"MediaTek PPM engine $([ "$val" = "1" ] && echo enabled || echo disabled)\"}"
        ;;

    set_ppm_boost)
        val="$1"
        chmod 666 /proc/ppm/policy_status 2>/dev/null
        echo "9 $val" > /proc/ppm/policy_status 2>/dev/null
        echo "{\"status\": \"ok\", \"message\": \"MediaTek PPM System Boost $([ "$val" = "1" ] && echo enabled || echo disabled)\"}"
        ;;

    set_ppm_thermal_bypass)
        val="$1" # 1 = bypass (disable throttling), 0 = active throttling
        chmod 666 /proc/ppm/policy_status 2>/dev/null
        if [ "$val" = "1" ]; then
            echo "4 0" > /proc/ppm/policy_status 2>/dev/null
            echo '{"status": "ok", "message": "MediaTek PPM thermal downclocking bypass enabled (Maximum sustained clocks)"}'
        else
            echo "4 1" > /proc/ppm/policy_status 2>/dev/null
            echo '{"status": "ok", "message": "MediaTek PPM thermal downclocking restored to default"}'
        fi
        ;;

    set_swappiness)
        val="$1"
        if [ -n "$val" ]; then
            sysctl -w vm.swappiness="$val" >/dev/null 2>&1
            echo "{\"status\": \"ok\", \"message\": \"VM swappiness set to $val\"}"
        fi
        ;;

    set_dirty_ratio)
        dr="$1"
        bg="$2"
        sysctl -w vm.dirty_ratio="$dr" >/dev/null 2>&1
        sysctl -w vm.dirty_background_ratio="$bg" >/dev/null 2>&1
        echo "{\"status\": \"ok\", \"message\": \"VM dirty ratios set to $dr% / $bg% (eliminates write stutter)\"}"
        ;;

    set_vfs_cache_pressure)
        val="$1"
        if [ -n "$val" ]; then
            sysctl -w vm.vfs_cache_pressure="$val" >/dev/null 2>&1
            echo "{\"status\": \"ok\", \"message\": \"VFS cache pressure set to $val\"}"
        fi
        ;;

    set_zram_algo)
        algo="$1"
        if [ -n "$algo" ]; then
            echo "$algo" > /sys/block/zram0/comp_algorithm 2>/dev/null
            echo "{\"status\": \"ok\", \"message\": \"ZRAM compression algorithm updated to $algo\"}"
        fi
        ;;

    drop_caches)
        val="${1:-3}"
        echo "$val" > /proc/sys/vm/drop_caches 2>/dev/null
        echo "{\"status\": \"ok\", \"message\": \"Memory cache flushed ($val: pagecache, dentries & inodes freed)\"}"
        ;;

    set_io_scheduler)
        sched="$1"
        if [ -n "$sched" ]; then
            for s in /sys/block/sd*/queue/scheduler; do
                chmod 666 "$s" 2>/dev/null
                echo "$sched" > "$s" 2>/dev/null
            done
            echo "{\"status\": \"ok\", \"message\": \"UFS 2.1 I/O scheduler set to $sched across all storage queues\"}"
        fi
        ;;

    set_read_ahead)
        kb="$1"
        if [ -n "$kb" ]; then
            echo "$kb" > "$STATE_DIR/cur_read_ahead"
            sectors=$((kb * 2))
            for b in /dev/block/sd* /dev/block/dm-*; do
                blockdev --setra "$sectors" "$b" >/dev/null 2>&1
            done
            for q in /sys/block/*/queue/read_ahead_kb; do
                echo "$kb" > "$q" 2>/dev/null
            done
            echo "{\"status\": \"ok\", \"message\": \"Storage read-ahead boosted to ${kb}KB\"}"
        fi
        ;;

    set_sched_child_runs)
        val="$1"
        echo "$val" > /proc/sys/kernel/sched_child_runs_first 2>/dev/null
        echo "{\"status\": \"ok\", \"message\": \"sched_child_runs_first set to $val ($([ "$val" = "1" ] && echo "Child runs first - lower fork latency" || echo "Parent runs first"))\"}"
        ;;

    set_sched_latency)
        val="$1"
        echo "$val" > /proc/sys/kernel/sched_latency_ns 2>/dev/null
        echo "{\"status\": \"ok\", \"message\": \"Kernel scheduler latency target set to $val ns\"}"
        ;;

    set_tcp_cong)
        cong="$1"
        if [ -n "$cong" ]; then
            sysctl -w net.ipv4.tcp_congestion_control="$cong" >/dev/null 2>&1
            echo "{\"status\": \"ok\", \"message\": \"TCP congestion control set to $cong\"}"
        fi
        ;;

    set_tcp_fastopen)
        val="$1"
        echo "$val" > /proc/sys/net/ipv4/tcp_fastopen 2>/dev/null
        echo "{\"status\": \"ok\", \"message\": \"TCP Fast Open set to $val (zero RTT connection reuse)\"}"
        ;;

    set_tcp_ecn)
        val="$1"
        echo "$val" > /proc/sys/net/ipv4/tcp_ecn 2>/dev/null
        echo "{\"status\": \"ok\", \"message\": \"TCP ECN set to $val\"}"
        ;;

    set_tcp_tw_reuse)
        val="$1"
        echo "$val" > /proc/sys/net/ipv4/tcp_tw_reuse 2>/dev/null
        echo "{\"status\": \"ok\", \"message\": \"TCP TIME-WAIT socket reuse $([ "$val" = "1" ] && echo enabled || echo disabled)\"}"
        ;;

    set_tcp_slow_start_idle)
        val="$1"
        echo "$val" > /proc/sys/net/ipv4/tcp_slow_start_after_idle 2>/dev/null
        echo "{\"status\": \"ok\", \"message\": \"TCP slow start after idle $([ "$val" = "1" ] && echo enabled || echo "disabled (maintains full speed across idle periods)")\"}"
        ;;

    set_tcp_buffers)
        val="$1"
        if [ "$val" = "1" ] || [ "$val" = "16mb" ]; then
            sysctl -w net.core.rmem_max=16777216 >/dev/null 2>&1
            sysctl -w net.core.wmem_max=16777216 >/dev/null 2>&1
            sysctl -w net.ipv4.tcp_rmem="4096 87380 16777216" >/dev/null 2>&1
            sysctl -w net.ipv4.tcp_wmem="4096 65536 16777216" >/dev/null 2>&1
            sysctl -w net.core.netdev_max_backlog=50000 >/dev/null 2>&1
            echo '{"status": "ok", "message": "TCP Gigabit buffers boosted to 16MB"}'
        elif [ "$val" = "32mb" ]; then
            sysctl -w net.core.rmem_max=33554432 >/dev/null 2>&1
            sysctl -w net.core.wmem_max=33554432 >/dev/null 2>&1
            sysctl -w net.ipv4.tcp_rmem="4096 87380 33554432" >/dev/null 2>&1
            sysctl -w net.ipv4.tcp_wmem="4096 65536 33554432" >/dev/null 2>&1
            sysctl -w net.core.netdev_max_backlog=100000 >/dev/null 2>&1
            echo '{"status": "ok", "message": "TCP Ultra buffers boosted to 32MB"}'
        else
            orig_r=$(cat "$STATE_DIR/orig_rmem_max" 2>/dev/null || echo 8388608)
            orig_w=$(cat "$STATE_DIR/orig_wmem_max" 2>/dev/null || echo 8388608)
            sysctl -w net.core.rmem_max="$orig_r" >/dev/null 2>&1
            sysctl -w net.core.wmem_max="$orig_w" >/dev/null 2>&1
            echo '{"status": "ok", "message": "TCP socket buffers reverted to stock values"}'
        fi
        ;;

    set_ip_forward)
        val="$1"
        if [ "$val" = "1" ]; then
            sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1
            sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null 2>&1
            echo '{"status": "ok", "message": "Kernel IP forwarding enabled (IPv4 + IPv6)"}'
        else
            sysctl -w net.ipv4.ip_forward=0 >/dev/null 2>&1
            sysctl -w net.ipv6.conf.all.forwarding=0 >/dev/null 2>&1
            echo '{"status": "ok", "message": "Kernel IP forwarding disabled"}'
        fi
        ;;

    set_nat)
        val="$1"
        if [ "$val" = "1" ]; then
            iptables -t nat -A POSTROUTING -o rmnet+ -j MASQUERADE 2>/dev/null
            iptables -t nat -A POSTROUTING -o eth+ -j MASQUERADE 2>/dev/null
            iptables -t nat -A POSTROUTING -o wlan+ -j MASQUERADE 2>/dev/null
            iptables -A FORWARD -j ACCEPT 2>/dev/null
            echo '{"status": "ok", "message": "Inter-interface NAT masquerading enabled across cellular, ethernet & Wi-Fi"}'
        else
            iptables -t nat -D POSTROUTING -o rmnet+ -j MASQUERADE 2>/dev/null
            iptables -t nat -D POSTROUTING -o eth+ -j MASQUERADE 2>/dev/null
            iptables -t nat -D POSTROUTING -o wlan+ -j MASQUERADE 2>/dev/null
            echo '{"status": "ok", "message": "Inter-interface NAT masquerading disabled"}'
        fi
        ;;

    set_hotspot_bypass)
        val="$1"
        if [ "$val" = "1" ]; then
            settings put global tether_dun_required 0
            settings put global tether_entitlement_check_state 0
            echo '{"status": "ok", "message": "Carrier hotspot DUN throttle bypass enabled"}'
        else
            settings put global tether_dun_required 1
            settings put global tether_entitlement_check_state 1
            echo '{"status": "ok", "message": "Carrier hotspot restrictions restored"}'
        fi
        ;;

    set_rps)
        val="$1"
        if [ "$val" = "1" ]; then
            for rps in /sys/class/net/*/queues/rx-*/rps_cpus; do
                [ -f "$rps" ] && echo "ff" > "$rps" 2>/dev/null
            done
            echo '{"status": "ok", "message": "RPS multi-core packet steering enabled (8 CPU cores)"}'
        else
            for rps in /sys/class/net/*/queues/rx-*/rps_cpus; do
                [ -f "$rps" ] && echo "0" > "$rps" 2>/dev/null
            done
            echo '{"status": "ok", "message": "RPS reverted to default single-core"}'
        fi
        ;;

    set_store_mode)
        val="$1"
        chmod 666 /sys/class/power_supply/battery/store_mode 2>/dev/null
        echo "$val" > /sys/class/power_supply/battery/store_mode 2>/dev/null
        echo "{\"status\": \"ok\", \"message\": \"Battery store / bypass charging mode $([ "$val" = "1" ] && echo "enabled (stops battery degradation & swelling for 24/7 router use)" || echo "disabled")\"}"
        ;;

    set_adb_wifi)
        val="$1"
        if [ "$val" = "1" ]; then
            setprop service.adb.tcp.port 5555
            stop adbd 2>/dev/null
            start adbd 2>/dev/null
            echo '{"status": "ok", "message": "Wireless ADB active on port 5555"}'
        else
            setprop service.adb.tcp.port -1
            stop adbd 2>/dev/null
            start adbd 2>/dev/null
            echo '{"status": "ok", "message": "Wireless ADB disabled"}'
        fi
        ;;

    send_at)
        cmd="$1"
        port="/dev/ttyC1"
        [ ! -c "$port" ] && port="/dev/ttyC_AT"
        if [ -c "$port" ]; then
            echo "$cmd" > "$port" 2>/dev/null
            res=$( (/data/adb/magisk/busybox timeout 1 cat "$port" | head -n 15) 2>/dev/null | tr '\r\n' ' ')
            [ -z "$res" ] && res="Command sent to $port"
            echo "{\"status\": \"ok\", \"response\": \"$res\"}"
        else
            echo "{\"status\": \"error\", \"message\": \"Modem AT port not found\"}"
        fi
        ;;

    apply_preset)
        preset="$1"
        case "$preset" in
            performance)
                # Max Performance / Gaming Preset
                echo "performance" > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null
                echo "performance" > /sys/devices/system/cpu/cpufreq/policy6/scaling_governor 2>/dev/null
                chmod 666 /proc/ppm/policy/* 2>/dev/null
                echo "1 -1" > /proc/ppm/policy/userlimit_max_cpu_freq 2>/dev/null
                echo 2000000 > /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq 2>/dev/null
                chmod 666 /proc/ppm/policy_status 2>/dev/null
                echo "9 1" > /proc/ppm/policy_status 2>/dev/null # PPM Boost
                echo "4 0" > /proc/ppm/policy_status 2>/dev/null # Bypass thermal throttle downclock
                sysctl -w vm.swappiness=10 >/dev/null 2>&1
                sysctl -w vm.dirty_ratio=20 >/dev/null 2>&1
                sysctl -w vm.dirty_background_ratio=10 >/dev/null 2>&1
                sysctl -w vm.vfs_cache_pressure=50 >/dev/null 2>&1
                echo 1 > /proc/sys/kernel/sched_child_runs_first 2>/dev/null
                echo 6000000 > /proc/sys/kernel/sched_latency_ns 2>/dev/null
                for s in /sys/block/sd*/queue/scheduler; do chmod 666 "$s" 2>/dev/null; echo deadline > "$s" 2>/dev/null; done
                for b in /dev/block/sd* /dev/block/dm-*; do blockdev --setra 1024 "$b" >/dev/null 2>&1; done
                echo 512 > "$STATE_DIR/cur_read_ahead" 2>/dev/null
                echo '{"status": "ok", "message": "Performance Profile activated: 2.0GHz unlocked, Deadline scheduler, 512KB read-ahead, PPM Boost on, low swap latency"}'
                ;;
            battery)
                # Extreme Battery Saver
                echo "powersave" > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null
                echo "schedutil" > /sys/devices/system/cpu/cpufreq/policy6/scaling_governor 2>/dev/null
                chmod 666 /proc/ppm/policy_status 2>/dev/null
                echo "9 0" > /proc/ppm/policy_status 2>/dev/null # Boost off
                echo "4 1" > /proc/ppm/policy_status 2>/dev/null # Thermal on
                echo "1 6" > /proc/ppm/policy/userlimit_max_cpu_freq 2>/dev/null
                echo 1650000 > /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq 2>/dev/null
                sysctl -w vm.swappiness=160 >/dev/null 2>&1
                sysctl -w vm.dirty_ratio=0 >/dev/null 2>&1
                sysctl -w vm.vfs_cache_pressure=100 >/dev/null 2>&1
                echo 0 > /proc/sys/kernel/sched_child_runs_first 2>/dev/null
                echo 10000000 > /proc/sys/kernel/sched_latency_ns 2>/dev/null
                for s in /sys/block/sd*/queue/scheduler; do chmod 666 "$s" 2>/dev/null; echo cfq > "$s" 2>/dev/null; done
                echo 128 > "$STATE_DIR/cur_read_ahead" 2>/dev/null
                echo '{"status": "ok", "message": "Battery Saver Profile activated: Powersave governors, stock thermal caps, high swappiness"}'
                ;;
            router)
                # Dedicated 24/7 5G Router Mode
                echo "schedutil" > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null
                echo "schedutil" > /sys/devices/system/cpu/cpufreq/policy6/scaling_governor 2>/dev/null
                sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1
                sysctl -w net.ipv6.conf.all.forwarding=1 >/dev/null 2>&1
                iptables -t nat -A POSTROUTING -o rmnet+ -j MASQUERADE 2>/dev/null
                iptables -t nat -A POSTROUTING -o eth+ -j MASQUERADE 2>/dev/null
                iptables -t nat -A POSTROUTING -o wlan+ -j MASQUERADE 2>/dev/null
                iptables -A FORWARD -j ACCEPT 2>/dev/null
                settings put global tether_dun_required 0 2>/dev/null
                settings put global tether_entitlement_check_state 0 2>/dev/null
                for rps in /sys/class/net/*/queues/rx-*/rps_cpus; do [ -f "$rps" ] && echo "ff" > "$rps" 2>/dev/null; done
                sysctl -w net.core.rmem_max=16777216 >/dev/null 2>&1
                sysctl -w net.core.wmem_max=16777216 >/dev/null 2>&1
                sysctl -w net.ipv4.tcp_rmem="4096 87380 16777216" >/dev/null 2>&1
                sysctl -w net.ipv4.tcp_wmem="4096 65536 16777216" >/dev/null 2>&1
                sysctl -w net.core.netdev_max_backlog=50000 >/dev/null 2>&1
                sysctl -w net.ipv4.tcp_fastopen=3 >/dev/null 2>&1
                chmod 666 /sys/class/power_supply/battery/store_mode 2>/dev/null
                echo 1 > /sys/class/power_supply/battery/store_mode 2>/dev/null # Bypass battery charging
                echo '{"status": "ok", "message": "Dedicated 5G Router Profile activated: IP forwarding, NAT, 16MB socket buffers, RPS 8-core, Store Mode bypass charging"}'
                ;;
            balanced|*)
                # Balanced Stock Daily Driver
                echo "schedutil" > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null
                echo "schedutil" > /sys/devices/system/cpu/cpufreq/policy6/scaling_governor 2>/dev/null
                chmod 666 /proc/ppm/policy_status 2>/dev/null
                echo "9 0" > /proc/ppm/policy_status 2>/dev/null
                echo "4 1" > /proc/ppm/policy_status 2>/dev/null
                sysctl -w vm.swappiness=60 >/dev/null 2>&1
                sysctl -w vm.dirty_ratio=20 >/dev/null 2>&1
                sysctl -w vm.dirty_background_ratio=10 >/dev/null 2>&1
                sysctl -w vm.vfs_cache_pressure=100 >/dev/null 2>&1
                sysctl -w net.ipv4.tcp_congestion_control=cubic >/dev/null 2>&1
                for s in /sys/block/sd*/queue/scheduler; do chmod 666 "$s" 2>/dev/null; echo cfq > "$s" 2>/dev/null; done
                for b in /dev/block/sd* /dev/block/dm-*; do blockdev --setra 512 "$b" >/dev/null 2>&1; done
                echo 256 > "$STATE_DIR/cur_read_ahead" 2>/dev/null
                echo '{"status": "ok", "message": "Balanced Daily Driver Profile activated: Schedutil governor, Cubic TCP, 256KB read-ahead, 60 swappiness"}'
                ;;
        esac
        ;;

    revert_all)
        # Restore all original factory defaults
        [ -f "$STATE_DIR/orig_ip_forward" ] && sysctl -w net.ipv4.ip_forward=$(cat "$STATE_DIR/orig_ip_forward") >/dev/null 2>&1
        [ -f "$STATE_DIR/orig_ipv6_forward" ] && sysctl -w net.ipv6.conf.all.forwarding=$(cat "$STATE_DIR/orig_ipv6_forward") >/dev/null 2>&1
        [ -f "$STATE_DIR/orig_tcp_cong" ] && sysctl -w net.ipv4.tcp_congestion_control=$(cat "$STATE_DIR/orig_tcp_cong") >/dev/null 2>&1
        [ -f "$STATE_DIR/orig_tcp_fastopen" ] && echo $(cat "$STATE_DIR/orig_tcp_fastopen") > /proc/sys/net/ipv4/tcp_fastopen 2>/dev/null
        [ -f "$STATE_DIR/orig_tcp_ecn" ] && echo $(cat "$STATE_DIR/orig_tcp_ecn") > /proc/sys/net/ipv4/tcp_ecn 2>/dev/null
        [ -f "$STATE_DIR/orig_swappiness" ] && sysctl -w vm.swappiness=$(cat "$STATE_DIR/orig_swappiness") >/dev/null 2>&1
        [ -f "$STATE_DIR/orig_dirty_ratio" ] && sysctl -w vm.dirty_ratio=$(cat "$STATE_DIR/orig_dirty_ratio") >/dev/null 2>&1
        [ -f "$STATE_DIR/orig_dirty_bg_ratio" ] && sysctl -w vm.dirty_background_ratio=$(cat "$STATE_DIR/orig_dirty_bg_ratio") >/dev/null 2>&1
        [ -f "$STATE_DIR/orig_vfs_cache_pressure" ] && sysctl -w vm.vfs_cache_pressure=$(cat "$STATE_DIR/orig_vfs_cache_pressure") >/dev/null 2>&1
        [ -f "$STATE_DIR/orig_sched_child_runs_first" ] && echo $(cat "$STATE_DIR/orig_sched_child_runs_first") > /proc/sys/kernel/sched_child_runs_first 2>/dev/null
        [ -f "$STATE_DIR/orig_sched_latency_ns" ] && echo $(cat "$STATE_DIR/orig_sched_latency_ns") > /proc/sys/kernel/sched_latency_ns 2>/dev/null
        
        orig_gov0=$(cat "$STATE_DIR/orig_cpu_gov0" 2>/dev/null || echo schedutil)
        echo "$orig_gov0" > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null
        orig_gov6=$(cat "$STATE_DIR/orig_cpu_gov6" 2>/dev/null || echo schedutil)
        echo "$orig_gov6" > /sys/devices/system/cpu/cpufreq/policy6/scaling_governor 2>/dev/null
        orig_max6=$(cat "$STATE_DIR/orig_cpu_max_freq6" 2>/dev/null || echo 1650000)
        echo "$orig_max6" > /sys/devices/system/cpu/cpufreq/policy6/scaling_max_freq 2>/dev/null

        orig_sched=$(cat "$STATE_DIR/orig_io_scheduler" 2>/dev/null | grep -o '\[.*\]' | tr -d '[]' || echo cfq)
        for s in /sys/block/sd*/queue/scheduler; do chmod 666 "$s" 2>/dev/null; echo "$orig_sched" > "$s" 2>/dev/null; done
        echo 128 > "$STATE_DIR/cur_read_ahead" 2>/dev/null
        for b in /dev/block/sd* /dev/block/dm-*; do blockdev --setra 256 "$b" >/dev/null 2>&1; done

        # Remove custom NAT rules
        iptables -t nat -D POSTROUTING -o rmnet+ -j MASQUERADE 2>/dev/null
        iptables -t nat -D POSTROUTING -o eth+ -j MASQUERADE 2>/dev/null
        iptables -t nat -D POSTROUTING -o wlan+ -j MASQUERADE 2>/dev/null
        
        # Revert RPS
        for rps in /sys/class/net/*/queues/rx-*/rps_cpus; do [ -f "$rps" ] && echo "0" > "$rps" 2>/dev/null; done
        
        # Revert DUN bypass
        orig_dun=$(cat "$STATE_DIR/orig_dun_required" 2>/dev/null || echo 1)
        settings put global tether_dun_required "$orig_dun" 2>/dev/null
        
        # Revert PPM
        chmod 666 /proc/ppm/policy_status 2>/dev/null
        echo "9 0" > /proc/ppm/policy_status 2>/dev/null # Boost off
        echo "4 1" > /proc/ppm/policy_status 2>/dev/null # Thermal on

        echo '{"status": "ok", "message": "All kernel, network, CPU, memory, and storage parameters successfully reverted to factory defaults"}'
        ;;

    *)
        echo "{\"status\": \"error\", \"message\": \"Unknown action $action\"}"
        ;;
esac
